REGION_LABEL=default
HOST_LABEL=host-01

REMOTE_WRITE_URL=https://monitor.example.com/api/v1/write
REMOTE_WRITE_USERNAME=agent
REMOTE_WRITE_PASSWORD=change-me

# Optional desired-state container monitoring. Enable it by layering
# docker-compose.containers.yml on top of the base Compose file.
COMPOSE_PROJECT_DIRECTORY=/opt/s2snext
MONITORED_CONTAINER_NAMES=
CONTAINER_COLLECTION_INTERVAL=15
