prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"

  filesystem {
    mount_points_exclude = "^/(dev|proc|sys|var/lib/docker/.+|run)($|/)"
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|parsecfs|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host.receiver]
}

prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    target_label = "job"
    replacement  = sys.env("REGION_LABEL")
  }

  rule {
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_LABEL")
  }

  rule {
    source_labels = ["__name__"]
    regex         = "node_uname_info"
    target_label  = "nodename"
    replacement   = sys.env("HOST_LABEL")
  }
}

prometheus.scrape "containers" {
  targets = [{
    "__address__" = "cadvisor:8080",
    "exporter"    = "cadvisor",
  }]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.agent.receiver]
}

discovery.file "optional" {
  files            = ["/etc/alloy/optional-targets/*.yml"]
  refresh_interval = "30s"
}

prometheus.scrape "optional" {
  targets         = discovery.file.optional.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.agent.receiver]
}

prometheus.relabel "agent" {
  forward_to = [prometheus.remote_write.central.receiver]

  rule {
    target_label = "job"
    replacement  = sys.env("REGION_LABEL")
  }

  rule {
    target_label = "host"
    replacement  = sys.env("HOST_LABEL")
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_LABEL")
  }
}

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("REMOTE_WRITE_URL")

    basic_auth {
      username = sys.env("REMOTE_WRITE_USERNAME")
      password = sys.env("REMOTE_WRITE_PASSWORD")
    }
  }
}
